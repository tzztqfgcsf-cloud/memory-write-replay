        {
          "role": "user",
          "source_turn_id": "MUL1930.json#turn0",
          "text": "I am heading to Cambridge and I would like to know about some places to see in the north, do you have any suggestions?"
        },
        {
          "role": "system",
          "source_turn_id": "MUL1930.json#turn1",
          "text": "The Milton Country Park is popular among visitors. Would you like the address?"
        },
