      "candidate_texts": [
        {
          "candidate_id": "c1",
          "source_turn_id": "PMUL1635.json#turn14",
          "text": "Yes. Sorry, but suddenly my plans changed. Can you change the Wartworth booking to Monday for 3 people and 4 nights?"
        }
      ],
      "case_id": "MW24-PMUL1635-t14",
      "current_turn_id": "PMUL1635.json#turn14",
      "current_utterance": {
        "role": "user",
        "source_locator": "MULTIWOZ2.4/data.json#/PMUL1635.json/log/14/text",
        "source_turn_id": "PMUL1635.json#turn14",
        "text": "Yes. Sorry, but suddenly my plans changed. Can you change the Wartworth booking to Monday for 3 people and 4 nights?"
      },
      "dialogue_id": "PMUL1635.json",
      "history": [
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn0",
          "text": "I need to book a hotel in the east that has 4 stars.  "
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn1",
          "text": "I can help you with that. What is your price range?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn2",
          "text": "That doesn't matter as long as it has free wifi and parking."
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn3",
          "text": "If you'd like something cheap, I recommend the Allenbell. For something moderately priced, I would recommend the Warkworth House."
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn4",
          "text": "Could you book the Wartworth for one night, 1 person?"
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn5",
          "text": "What day will you be staying?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn6",
          "text": "Friday and Can you book it for me and get a reference number ?"
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn7",
          "text": "Booking was successful.\nReference number is : BMUKPTG6.  Can I help you with anything else today?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn8",
          "text": "I am looking to book a train that is leaving from Cambridge to Bishops Stortford on Friday. "
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn9",
          "text": "There are a number of trains leaving throughout the day.  What time would you like to travel?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn10",
          "text": "I want to get there by 19:45 at the latest. "
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn11",
          "text": "Okay! The latest train you can take leaves at 17:29, and arrives by 18:07. Would you like for me to book that for you?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL1635.json#turn12",
          "text": "Yes please. I also need the travel time, departure time, and price."
        },
        {
          "role": "system",
          "source_turn_id": "PMUL1635.json#turn13",
          "text": "Reference number is : UIFV8FAS. The price is 10.1 GBP and the trip will take about 38 minutes. May I be of any other assistance?"
        }
      ],
