      "candidate_texts": [
        {
          "candidate_id": "c1",
          "source_turn_id": "PMUL4646.json#turn16",
          "text": "I'm sorry, I made a mistake!  I need for it to start on Tuesday not Thursday!!!!  Can you fix that for me???"
        }
      ],
      "case_id": "MW24-PMUL4646-t16",
      "current_turn_id": "PMUL4646.json#turn16",
      "current_utterance": {
        "role": "user",
        "source_locator": "MULTIWOZ2.4/data.json#/PMUL4646.json/log/16/text",
        "source_turn_id": "PMUL4646.json#turn16",
        "text": "I'm sorry, I made a mistake!  I need for it to start on Tuesday not Thursday!!!!  Can you fix that for me???"
      },
      "dialogue_id": "PMUL4646.json",
      "history": [
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn0",
          "text": "does cambridge museum of technology still open?"
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn1",
          "text": "Yes, it does."
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn2",
          "text": "What's the entrance fee, phone number, and postcode for that museum?"
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn3",
          "text": "The entrance fee is 5 pounds. Phone number is 01223368650. And the postcode is cb58ld."
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn4",
          "text": "I'm looking for a place to stay in the centre. I also need free wifi there."
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn5",
          "text": "We have two guesthouses and three hotels in town centre. Do you have a pricerange in mind?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn6",
          "text": "I'd like an expensive hotel please."
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn7",
          "text": "There are two expensive hotels in the area of Centre.  The Gonville has a 3 star rating and the University Arms has 4.  Do you have a preference?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn8",
          "text": "Yes the university arms would you be able to book that?"
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn9",
          "text": "Yes certainly. How many nights will you be needing and when will you be arriving and how many people will be staying?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn10",
          "text": "6 people, five nights, starting on Thursday, please."
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn11",
          "text": "Would you like me to book the room now?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn12",
          "text": "Yes please book that. "
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn13",
          "text": "OK, you're all set. 6 people for 5 nights at University Arms. Arriving on Thursday. Your Reference number is : TXXXCWJD. Is there anything else I can do today?"
        },
        {
          "role": "user",
          "source_turn_id": "PMUL4646.json#turn14",
          "text": "That's perfect. Thank you so much. "
        },
        {
          "role": "system",
          "source_turn_id": "PMUL4646.json#turn15",
          "text": "Do you need to arrange transportation to town, or between any venues? If not, it was my pleasure to help you and have a great day!"
        }
      ],
