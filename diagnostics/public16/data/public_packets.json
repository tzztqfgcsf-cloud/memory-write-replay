        "source_turn_id": "MUL1664.json#turn10",
        "text": "I'm sorry, I said I needed a seat for me, but I actually need 7 seats total.  My friends would not be happy if I stranded them.  "
      },
      "dialogue_id": "MUL1664.json",
      "history": [
        {
          "role": "user",
          "source_turn_id": "MUL1664.json#turn0",
          "text": "I'm looking for a restaurant called the varsity restaurant. "
        },
        {
          "role": "system",
          "source_turn_id": "MUL1664.json#turn1",
          "text": "I've located the Varsity restaurant, would you like me to make reservations there for you?"
        },
        {
          "role": "user",
          "source_turn_id": "MUL1664.json#turn2",
          "text": "Yes please.  I need a table for 7 people at 11:30 on Wednesday."
        },
        {
          "role": "system",
          "source_turn_id": "MUL1664.json#turn3",
          "text": "I have booked you a table. the Reference number is : B19Y67KT."
        },
        {
          "role": "user",
          "source_turn_id": "MUL1664.json#turn4",
          "text": "I'm also looking for a train to London Liverpool Street arriving by 20:30. "
        },
        {
          "role": "system",
          "source_turn_id": "MUL1664.json#turn5",
          "text": "What day would you like to go and where will you be departing from?"
        },
        {
          "role": "user",
          "source_turn_id": "MUL1664.json#turn6",
          "text": "The train should depart from Cambridge and should leave on Thursday."
        },
        {
          "role": "system",
          "source_turn_id": "MUL1664.json#turn7",
          "text": "Train TR6332 leaves for London Liverpool street on thursday 17: 59 and arrives at 19:27. can i book it for you?"
        },
        {
          "role": "user",
          "source_turn_id": "MUL1664.json#turn8",
          "text": "Yes. Please book a seat on train TR6332 for me."
        },
        {
          "role": "system",
          "source_turn_id": "MUL1664.json#turn9",
          "text": "Ok, I have successfully booked a seat on TR6332. The cost will be 16.6 GBP and your reference number is QQ53PXEI."
        }
      ],
