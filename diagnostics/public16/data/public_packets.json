      "dialogue_id": "MUL0329.json",
      "history": [
        {
          "role": "user",
          "source_turn_id": "MUL0329.json#turn0",
          "text": "I want to find an expensive Indian restaurant."
        },
        {
          "role": "system",
          "source_turn_id": "MUL0329.json#turn1",
          "text": "There are 14 Indian restaurants in the expensive price range. What part of town would you like?"
        },
        {
          "role": "user",
          "source_turn_id": "MUL0329.json#turn2",
          "text": "I'd like the restaurant to be in the centre."
        },
        {
          "role": "system",
          "source_turn_id": "MUL0329.json#turn3",
          "text": "Curry Garden meets your criteria. The address is 106 Regent Street City Centre. Would you like to make a reservation? "
        },
        {
          "role": "user",
          "source_turn_id": "MUL0329.json#turn4",
          "text": "What is the postal code for the Curry Garden?"
        },
        {
          "role": "system",
          "source_turn_id": "MUL0329.json#turn5",
          "text": "The postcode for Curry Garden is cb21dp."
        },
        {
          "role": "user",
          "source_turn_id": "MUL0329.json#turn6",
          "text": "Ok, great thanks. Can you also help me find a train going to stevenage? "
        },
        {
          "role": "system",
          "source_turn_id": "MUL0329.json#turn7",
          "text": "There are 70 trains to Cambridge. What day will you be travelling?"
        }
